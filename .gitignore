# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
.ipynb_checkpoints/

# Secrets and local-only configuration
.env
.env.*
!.env.example
*.pem
*.key
/kaggle.json
/.netrc

# Official files currently supplied at the repository root
/deep_chal_math_train.csv
/deep_chal_math_leaderboard_filtered.csv
/train_filtered_ids.csv
/deep_chal_math_dataset_test.csv
/deep_chal_math_test.csv
/test_submission.csv
/test_flag.csv
/submission.csv
/submission.csv.sha256
/submission.sha256

# Raw and externally downloaded datasets are never committed
/data/raw/**
!/data/raw/.gitkeep
/data/external/**
!/data/external/.gitkeep

# Large derived dataset payloads; small manifests remain trackable
/data/processed/**/*.csv
/data/processed/**/*.jsonl
/data/processed/**/*.parquet
/data/processed/**/*.arrow
/data/splits/**/*.csv
/data/splits/**/*.jsonl
/data/splits/**/*.parquet
/data/splits/**/*.arrow

# Run outputs, caches, and model weights
/outputs/**
!/outputs/.gitkeep
/E000_*_canonical_artifacts.tar.gz
/E001_*_canonical_artifacts.tar.gz
/E001_*_canonical_artifacts.manifest.json
/wandb/
/runs/
*.safetensors
*.ckpt
*.pt
*.pth
pytorch_model*.bin
adapter_model*.bin
/.cache/
/.huggingface/
/huggingface/
/models/
/FINAL_E000_PARTIAL_*_RESUME.tar.gz
/shard*.log
/nohup.out

# Canonical payloads remain local; track only the exact-reproduction layout guide.
/artifacts/**
!/artifacts/final_submission/
!/artifacts/final_submission/README.md
!/artifacts/final_submission/partial_989/
!/artifacts/final_submission/partial_989/predictions.csv
!/artifacts/final_submission/partial_989/input_identity.json
!/artifacts/final_submission/partial_989/resume_identity.json
!/artifacts/final_submission/partial_989/run_manifest.json
!/artifacts/final_submission/shard_0/
!/artifacts/final_submission/shard_0/predictions.csv
!/artifacts/final_submission/shard_0/input_identity.json
!/artifacts/final_submission/shard_0/resume_identity.json
!/artifacts/final_submission/shard_0/run_manifest.json
